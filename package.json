{
  "name": "@addon-pass/sdk",
  "version": "0.1.2",
  "description": "Fail-closed entitlement middleware for private Stremio add-ons using AddonPass.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AddonPass/addonpass-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/AddonPass/addonpass-sdk/issues"
  },
  "homepage": "https://github.com/AddonPass/addonpass-sdk#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "2.56.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "express": "5.2.1",
    "fastify": "5.12.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "express": ">=5.2.1 <6",
    "fastify": ">=5.12.1 <6"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
